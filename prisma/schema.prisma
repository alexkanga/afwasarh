generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  managerId   String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  manager     Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[] @relation("DepartmentEmployees")
}

model Position {
  id          String     @id @default(cuid())
  title       String     @unique
  description String?
  baseSalary  Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[] @relation("PositionEmployees")
}

model Employee {
  id                String             @id @default(cuid())
  employeeNumber    String             @unique
  firstName         String
  lastName          String
  email             String             @unique
  phone             String?
  birthDate         DateTime?
  hireDate          DateTime
  terminationDate   DateTime?
  status            EmployeeStatus     @default(ACTIVE)
  photo             String?
  address           String?
  departmentId      String?
  positionId        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  absences          Absence[]
  contracts         Contract[]
  managedDepartment Department?        @relation("DepartmentManager")
  department        Department?        @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  position          Position?          @relation("PositionEmployees", fields: [positionId], references: [id])
  trainings         EmployeeTraining[]
  movements         Movement[]
  salaries          Salary[]
}

model Contract {
  id            String       @id @default(cuid())
  employeeId    String
  type          ContractType
  startDate     DateTime
  endDate       DateTime?
  monthlySalary Float
  workHours     Float        @default(35)
  isActive      Boolean      @default(true)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employee      Employee     @relation(fields: [employeeId], references: [id])
}

model Absence {
  id         String        @id @default(cuid())
  employeeId String
  type       AbsenceType
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String?
  status     AbsenceStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  employee   Employee      @relation(fields: [employeeId], references: [id])
}

model Training {
  id                String             @id @default(cuid())
  title             String
  description       String?
  provider          String?
  duration          Float
  cost              Float
  category          String?
  startDate         DateTime?
  endDate           DateTime?
  location          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  employeeTrainings EmployeeTraining[]
}

model EmployeeTraining {
  id             String         @id @default(cuid())
  employeeId     String
  trainingId     String
  status         TrainingStatus @default(REGISTERED)
  startDate      DateTime?
  endDate        DateTime?
  hoursCompleted Float          @default(0)
  certificate    String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  employee       Employee       @relation(fields: [employeeId], references: [id])
  training       Training       @relation(fields: [trainingId], references: [id])
}

model Salary {
  id            String       @id @default(cuid())
  employeeId    String
  month         DateTime
  baseSalary    Float
  bonus         Float        @default(0)
  overtime      Float        @default(0)
  deductions    Float        @default(0)
  socialCharges Float        @default(0)
  netSalary     Float
  grossSalary   Float
  paidAt        DateTime?
  status        SalaryStatus @default(PENDING)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employee      Employee     @relation(fields: [employeeId], references: [id])
}

model Movement {
  id             String       @id @default(cuid())
  employeeId     String
  type           MovementType
  effectiveDate  DateTime
  reason         String?
  fromDepartment String?
  toDepartment   String?
  fromPosition   String?
  toPosition     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id])
}

model HRKPI {
  id                String   @id @default(cuid())
  date              DateTime @unique
  totalEmployees    Int
  newHires          Int
  terminations      Int
  turnoverRate      Float
  avgTenure         Float
  totalAbsentDays   Float
  totalSalaryCost   Float
  totalTrainingCost Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum ContractType {
  CDI
  CDD
  INTERIM
  APPRENTICESHIP
  PART_TIME
}

enum AbsenceType {
  PAID_LEAVE
  SICK_LEAVE
  RTT
  UNPAID_LEAVE
  MATERNITY
  PATERNITY
  FAMILY_EVENT
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TrainingStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
}

enum MovementType {
  HIRE
  TERMINATION
  TRANSFER
  PROMOTION
  DEMOTION
  RETURN
}
